{
  "name": "virtualdj-mcp",
  "version": "1.0.0",
  "description": "Professional DJ automation MCP server with VirtualDJ integration for mixing, library management, and performance control",
  "author": "Sandra",
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/virtualdj-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/virtualdj-mcp"
  },
  "main": "server/server.py",
  "mcp": {
    "version": "1.0",
    "capabilities": ["tools"],
    "prompts": {
      "system": "assets/prompts/system.md",
      "dj_performance": "assets/prompts/dj_performance.md",
      "mixing_guide": "assets/prompts/mixing_guide.md",
      "library_management": "assets/prompts/library_management.md",
      "automation": "assets/prompts/automation.md",
      "troubleshooting": "assets/prompts/troubleshooting.md"
    }
  },
  "runtime": {
    "python": ">=3.11"
  },
  "dependencies": {
    "fastmcp": ">=2.13.1",
    "pydantic": ">=2.0.0",
    "httpx": ">=0.27.0"
  },
  "features": [
    "Deck control (play, pause, stop, seek, volume)",
    "Mixing tools (crossfader, sync, beatmatching, EQ)",
    "Library management (browse, search, track info)",
    "Automation (Auto-DJ, recording, session management)",
    "Performance monitoring (real-time status, variables)",
    "Multi-deck support (up to 8 decks)",
    "VDJScript integration",
    "FastAPI web interface"
  ],
  "requirements": {
    "software": ["VirtualDJ 2024 or later"],
    "license": ["VirtualDJ Pro (for some advanced features)"],
    "os": ["Windows 10/11", "macOS 10.15+"]
  },
  "keywords": [
    "dj",
    "virtualdj",
    "mixing",
    "automation",
    "music",
    "audio",
    "performance",
    "austria"
  ]
}

