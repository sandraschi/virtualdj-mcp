# VirtualDJ-MCP Environment Configuration
# Rename to .env and fill in your values.

# VirtualDJ Application Settings
VDJ_PATH=C:/Program Files/VirtualDJ/virtualdj.exe

# Network Control Plugin (primary control channel)
VDJ_HTTP_HOST=127.0.0.1
VDJ_HTTP_PORT=80
VDJ_HTTP_PASSWORD=
VDJ_HTTP_TIMEOUT=10.0

# OSC (OS2V) port — must match VirtualDJ Settings > OSC
VDJ_OSC_PORT=40100

# Tool mode: "portmanteau" (default, 13 tools) or "individual" (62+ legacy)
VDJ_TOOL_MODE=portmanteau

# Library Settings
VDJ_LIBRARY_PATH=C:/Music
VDJ_DEFAULT_VOLUME=75

# Performance Settings
VDJ_MAX_DECKS=4
VDJ_UPDATE_INTERVAL=0.5

# Recording Settings
VDJ_RECORDING_PATH=./recordings
VDJ_RECORDING_FORMAT=mp3
VDJ_RECORDING_QUALITY=320

# Plex Integration (optional)
PLEX_SERVER_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# Logging
LOG_LEVEL=INFO
