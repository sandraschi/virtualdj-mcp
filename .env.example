# VirtualDJ-MCP Environment Configuration

# VirtualDJ Application Settings
VDJ_PATH=C:/Program Files/VirtualDJ/virtualdj.exe

# API Configuration  
VDJ_API_HOST=localhost
VDJ_API_PORT=8080

# Library Settings
VDJ_LIBRARY_PATH=C:/Music
VDJ_DEFAULT_VOLUME=75

# Performance Settings
VDJ_MAX_DECKS=4
VDJ_UPDATE_INTERVAL=0.5

# Recording Settings
VDJ_RECORDING_PATH=./recordings
VDJ_RECORDING_FORMAT=mp3
VDJ_RECORDING_QUALITY=320

# Logging
LOG_LEVEL=INFO
